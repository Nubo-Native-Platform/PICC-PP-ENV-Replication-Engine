# ==============================================================================
# PICC-PP-ENV-Replication-Engine - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot microservice listens (Default: 8082)
SERVER_PORT=8082

# Active Spring Profile (e.g., main, dev, local)
SPRING_PROFILES_ACTIVE=main

# Spring Cloud Config Label
CONFIG_LABEL=v1

# Centralized configuration server URL (if used)
CONFIG_SERVER_URL=http://localhost:8888

# ------------------------------------------------------------------------------
# 2. GitOps Repository & Git Integration
# ------------------------------------------------------------------------------
# Local working directory for cloning and generating GitOps manifests
GITOPS_FOLDER=./gitops

# Base URL for GitLab / Git hosting platform
GITOPS_GITLAB_URL=https://gitlab.example.com

# Target Git repository path template (${env} gets replaced dynamically)
GITOPS_REPOPATH=/env-replication-gitops/${env}-synch.git

# FreeMarker templates directory containing app.yaml
GITOPS_TEMPLATE=./template

# Git authentication credentials for cloning and committing manifests
GITLAB_REPO_USER=gitops-bot
GITLAB_REPO_PASSWORD=yourSecretGitPasswordHere
GITLAB_NNP_USER=nnp-support

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# JDBC URL of the NNP Platform / Portal database
DATASOURCE_URL=jdbc:postgresql://localhost:5432/eiimp-platform
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=yourSecretDbPasswordHere
HIBERNATE_DDL_AUTO=none
SHOW_SQL=false

# ------------------------------------------------------------------------------
# 4. Apache ActiveMQ Artemis Message Broker
# ------------------------------------------------------------------------------
# JMS Broker connection URL
ACTIVEMQ_BROKER_URL=tcp://localhost:61616
ACTIVEMQ_USER=artemis
ACTIVEMQ_PASSWORD=yourSecretArtemisPasswordHere

# ------------------------------------------------------------------------------
# 5. Outbound Microservice Integration (WebClient)
# ------------------------------------------------------------------------------
# Redmine Integration Service URL
REDMINE_SERVICE_BASEURL=http://localhost:8095/redmineint

# Git Integration Service URL
GITINT_SERVICE_BASEURL=http://localhost:8094/gitlabint

# Mail Notification Service URL
MAIL_SERVICE_BASEURL=http://localhost:8080

# HAProxy Ingress Integration Microservice URL (PICC-PC-Haproxy-Integration)
HAPROXY_SERVICE_BASEURL=http://localhost:8081

# ------------------------------------------------------------------------------
# 6. Redmine Ticketing Integration
# ------------------------------------------------------------------------------
REDMINE_API_KEY=yourSecretRedmineApiKeyHere
REDMINE_PROJECT_NAME=EIIMP Environment Support

# ------------------------------------------------------------------------------
# 7. ArgoCD API Integration (OpenFeign)
# ------------------------------------------------------------------------------
ARGO_USER=admin
ARGO_PASSWORD=yourSecretArgoPasswordHere
FEIGN_NAME=argo-client
FEIGN_URL=http://localhost:8080
FEIGN_URL_API=/api/v1

# ------------------------------------------------------------------------------
# 8. Container Image Registries & Kubernetes Configuration
# ------------------------------------------------------------------------------
GITLCNC_REGISTRY_URL=https://registry.example.com
GITLAB_NNP_REGISTRY_URL=https://registry.example.com
K8S_NODE_AFFINITY_LABEL=default-node-group
HAPROXY_BASE_DOMAIN=nnp.nubons.com

# ------------------------------------------------------------------------------
# 9. Logging & Diagnostics
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
FEIGN_LOG_LEVEL=WARN
